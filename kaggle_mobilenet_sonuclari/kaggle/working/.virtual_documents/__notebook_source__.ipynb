from roboflow import Roboflow
import os
import shutil

print("1. Veri seti indiriliyor...")
rf = Roboflow(api_key="kUbEu0yS1GjZh8vEZb0H")
project = rf.workspace("umut-trker").project("yuk-araci-tespiti-u9phc")
version = project.version(2)
dataset = version.download("yolov8")
yolo_yolu = dataset.location

print("✅ 1. Aşama Tamamlandı: Veri başarıyla indirildi!")


print("2. Veriler klasörlere dönüştürülüyor...")

for split in ['train', 'valid']:
    os.makedirs(f"./siniflandirma_verisi/{split}/yuk_araci", exist_ok=True)
    os.makedirs(f"./siniflandirma_verisi/{split}/diger", exist_ok=True)

    images_dir = f"{yolo_yolu}/{split}/images"
    labels_dir = f"{yolo_yolu}/{split}/labels"

    if not os.path.exists(images_dir):
        continue

    for img_name in os.listdir(images_dir):
        txt_name = img_name.rsplit('.', 1)[0] + '.txt'
        txt_path = os.path.join(labels_dir, txt_name)
        img_path = os.path.join(images_dir, img_name)

        # Eğer txt dosyası varsa ve içi doluysa 'yuk_araci' klasörüne
        if os.path.exists(txt_path) and os.path.getsize(txt_path) > 0:
            shutil.copy(img_path, f"./siniflandirma_verisi/{split}/yuk_araci/{img_name}")
        # Yoksa veya boşsa 'diger' klasörüne
        else:
            shutil.copy(img_path, f"./siniflandirma_verisi/{split}/diger/{img_name}")

print("✅ 2. Aşama Tamamlandı: Klasörleme başarılı!")


import tensorflow as tf
from tensorflow.keras.applications import MobileNetV2
from tensorflow.keras.layers import Dense, GlobalAveragePooling2D
from tensorflow.keras.models import Model

print("3. Model hazırlanıyor...")
train_yolu = "./siniflandirma_verisi/train"
valid_yolu = "./siniflandirma_verisi/valid"

train_dataset = tf.keras.preprocessing.image_dataset_from_directory(
    train_yolu, image_size=(224, 224), batch_size=32)
valid_dataset = tf.keras.preprocessing.image_dataset_from_directory(
    valid_yolu, image_size=(224, 224), batch_size=32)

base_model = MobileNetV2(weights='imagenet', include_top=False, input_shape=(224, 224, 3))
base_model.trainable = False 

x = base_model.output
x = GlobalAveragePooling2D()(x)
predictions = Dense(len(train_dataset.class_names), activation='softmax')(x)
model = Model(inputs=base_model.input, outputs=predictions)

model.compile(optimizer='adam', loss='sparse_categorical_crossentropy', metrics=['accuracy'])

print("Eğitim Başlıyor (50 Epoch)...")
# Rapor grafikleri için 'history' değişkenine kaydediyoruz
history = model.fit(train_dataset, validation_data=valid_dataset, epochs=50)

model.save('mobilenetv2_yuk_araci_modeli.h5')
print("✅ 3. Aşama Tamamlandı: Eğitim bitti ve model kaydedildi!")


import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import classification_report, confusion_matrix

print("\n--- RAPOR VERİLERİ ÇIKARILIYOR ---")
print("\n[MODEL ÖZETİ - Rapor Bölüm 3.4 için]")
model.summary()

# Eğitim Grafikleri Çizimi
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history['accuracy'], label='Eğitim Doğruluğu')
plt.plot(history.history['val_accuracy'], label='Doğrulama Doğruluğu')
plt.title('Model Doğruluğu (Accuracy)')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(history.history['loss'], label='Eğitim Kaybı')
plt.plot(history.history['val_loss'], label='Doğrulama Kaybı')
plt.title('Model Kaybı (Loss)')
plt.legend()
plt.tight_layout()
plt.savefig('egitim_grafikleri.png')

print("\n[Tahminler Yapılıyor, Lütfen Bekleyin...]")
y_true = []
y_pred = []
for images, labels in valid_dataset:
    y_true.extend(labels.numpy())
    preds = model.predict(images, verbose=0)
    y_pred.extend(np.argmax(preds, axis=1))

sınıf_isimleri = valid_dataset.class_names

print("\n[SINIFLANDIRMA RAPORU - Rapor Bölüm 5.1 ve 5.2 için]")
print(classification_report(y_true, y_pred, target_names=sınıf_isimleri))

# Karışıklık Matrisi Çizimi
plt.figure(figsize=(8, 6))
sns.heatmap(confusion_matrix(y_true, y_pred), annot=True, fmt='d', cmap='Blues', xticklabels=sınıf_isimleri, yticklabels=sınıf_isimleri)
plt.title('Karışıklık Matrisi (Confusion Matrix)')
plt.savefig('karisiklik_matrisi.png')

print("\n✅ TÜM İŞLEMLER BİTTİ! Grafikler sağ paneldeki Output klasörüne kaydedildi.")


import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.metrics import classification_report, confusion_matrix

print("\n--- RAPOR VERİLERİ ÇIKARILIYOR ---")
print("\n[MODEL ÖZETİ - Rapor Bölüm 3.4 için]")
model.summary()

# Eğitim Grafikleri Çizimi
plt.figure(figsize=(10, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history['accuracy'], label='Eğitim Doğruluğu')
plt.plot(history.history['val_accuracy'], label='Doğrulama Doğruluğu')
plt.title('Model Doğruluğu (Accuracy)')
plt.legend()

plt.subplot(1, 2, 2)
plt.plot(history.history['loss'], label='Eğitim Kaybı')
plt.plot(history.history['val_loss'], label='Doğrulama Kaybı')
plt.title('Model Kaybı (Loss)')
plt.legend()
plt.tight_layout()
plt.savefig('egitim_grafikleri.png')

print("\n[Tahminler Yapılıyor, Lütfen Bekleyin...]")
y_true = []
y_pred = []
for images, labels in valid_dataset:
    y_true.extend(labels.numpy())
    preds = model.predict(images, verbose=0)
    y_pred.extend(np.argmax(preds, axis=1))

sınıf_isimleri = valid_dataset.class_names

print("\n[SINIFLANDIRMA RAPORU - Rapor Bölüm 5.1 ve 5.2 için]")
# HATA ÇÖZÜMÜ: labels=[0, 1] ve zero_division=0 eklendi.
print(classification_report(y_true, y_pred, labels=[0, 1], target_names=sınıf_isimleri, zero_division=0))

# Karışıklık Matrisi Çizimi
plt.figure(figsize=(8, 6))
# HATA ÇÖZÜMÜ: Matrisin boyutunu sabitlemek için labels eklendi.
cm = confusion_matrix(y_true, y_pred, labels=[0, 1])
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=sınıf_isimleri, yticklabels=sınıf_isimleri)
plt.title('Karışıklık Matrisi (Confusion Matrix)')
plt.savefig('karisiklik_matrisi.png')

print("\n✅ TÜM İŞLEMLER BİTTİ! Grafikler sağ paneldeki Output klasörüne kaydedildi.")


